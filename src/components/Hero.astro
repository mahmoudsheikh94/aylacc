---
// Professional Hero Section for AYLA Construction
---

<section class="relative min-h-screen flex items-center overflow-hidden gradient-mesh">
  <!-- Subtle decorative elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none blueprint-pattern" aria-hidden="true">
    <!-- Subtle geometric accents -->
    <div class="absolute top-1/4 right-10 w-64 h-64 border border-accent/20 rounded-lg"></div>
    <div class="absolute bottom-1/3 left-10 w-48 h-48 border-2 border-primary/10 rounded"></div>
  </div>

  <!-- Main content -->
  <div class="relative container-professional py-24 lg:py-32">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left content -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-3 mb-6 opacity-0 animate-fade-in-up" style="animation-delay: 0.1s;">
          <div class="blue-line"></div>
          <span class="text-eyebrow">Premier Construction in the UK</span>
        </div>

        <!-- Main headline -->
        <h1 class="heading-xl mb-6">
          <span class="block opacity-0 animate-fade-in-up" style="animation-delay: 0.2s;">
            Building
          </span>
          <span class="block opacity-0 animate-fade-in-up" style="animation-delay: 0.3s;">
            <span class="text-gradient">Excellence</span>
          </span>
          <span class="block opacity-0 animate-fade-in-up" style="animation-delay: 0.4s;">
            Since 2004
          </span>
        </h1>

        <!-- Slogan -->
        <p class="font-display text-xl lg:text-2xl text-secondary font-medium mb-6 opacity-0 animate-fade-in-up"
           style="animation-delay: 0.5s;">
          Building with precision, Delivering with pride
        </p>

        <!-- Description -->
        <p class="text-large max-w-xl mx-auto lg:mx-0 mb-10 opacity-0 animate-fade-in-up"
           style="animation-delay: 0.6s;">
          From landmark commercial developments to bespoke residential projects,
          we deliver exceptional craftsmanship across the United Kingdom.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start opacity-0 animate-fade-in-up"
             style="animation-delay: 0.7s;">
          <a href="#contact" class="btn-primary">
            <span>Start Your Project</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/projects" class="btn-secondary">
            <span>View Portfolio</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-6 lg:gap-8 mt-12 opacity-0 animate-fade-in-up"
             style="animation-delay: 0.8s;">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-accent-light border border-accent rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-xs text-text-gray uppercase tracking-wide font-semibold">Fully</span>
              <span class="text-text-dark text-sm font-semibold">Insured</span>
            </div>
          </div>

          <div class="w-px h-10 bg-gray-200 hidden sm:block"></div>

          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-accent-light border border-accent rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-xs text-text-gray uppercase tracking-wide font-semibold">20+ Years</span>
              <span class="text-text-dark text-sm font-semibold">Experience</span>
            </div>
          </div>

          <div class="w-px h-10 bg-gray-200 hidden sm:block"></div>

          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-accent-light border border-accent rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-xs text-text-gray uppercase tracking-wide font-semibold">UK</span>
              <span class="text-text-dark text-sm font-semibold">Nationwide</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right - Stats showcase -->
      <div class="lg:col-span-5">
        <div class="relative opacity-0 animate-slide-right" style="animation-delay: 0.5s;">
          <!-- Main card -->
          <div class="relative card-accent p-8 lg:p-10 rounded-xl border-2 border-accent">
            <!-- Stats grid -->
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center p-6 bg-white rounded-lg border border-gray-200 hover:border-primary transition-all duration-300 group">
                <span class="block font-display text-4xl lg:text-5xl font-bold text-primary group-hover:scale-105 transition-transform duration-300">
                  100<span class="text-2xl lg:text-3xl">+</span>
                </span>
                <span class="block text-xs text-text-gray uppercase tracking-wide mt-2 font-semibold">Projects</span>
                <span class="text-text-dark text-sm font-medium">Completed</span>
              </div>

              <div class="text-center p-6 bg-white rounded-lg border border-gray-200 hover:border-primary transition-all duration-300 group">
                <span class="block font-display text-4xl lg:text-5xl font-bold text-primary group-hover:scale-105 transition-transform duration-300">
                  20<span class="text-2xl lg:text-3xl">+</span>
                </span>
                <span class="block text-xs text-text-gray uppercase tracking-wide mt-2 font-semibold">Years</span>
                <span class="text-text-dark text-sm font-medium">Experience</span>
              </div>

              <div class="text-center p-6 bg-white rounded-lg border border-gray-200 hover:border-primary transition-all duration-300 group">
                <span class="block font-display text-4xl lg:text-5xl font-bold text-primary group-hover:scale-105 transition-transform duration-300">
                  100<span class="text-2xl lg:text-3xl">%</span>
                </span>
                <span class="block text-xs text-text-gray uppercase tracking-wide mt-2 font-semibold">Client</span>
                <span class="text-text-dark text-sm font-medium">Satisfaction</span>
              </div>

              <div class="text-center p-6 bg-white rounded-lg border border-gray-200 hover:border-primary transition-all duration-300 group">
                <span class="block font-display text-4xl lg:text-5xl font-bold text-primary group-hover:scale-105 transition-transform duration-300">
                  6
                </span>
                <span class="block text-xs text-text-gray uppercase tracking-wide mt-2 font-semibold">Core</span>
                <span class="text-text-dark text-sm font-medium">Services</span>
              </div>
            </div>

            <!-- Bottom text -->
            <div class="mt-6 pt-6 border-t border-accent/50 text-center">
              <p class="text-text-gray text-sm font-medium">
                Trusted by homeowners and businesses across the
                <span class="text-primary font-semibold">United Kingdom</span>
              </p>
            </div>

            <!-- Corner decorations -->
            <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-primary rounded-tl"></div>
            <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-primary rounded-br"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 animate-fade-in"
       style="animation-delay: 1s;">
    <span class="text-xs tracking-[0.2em] text-text-gray uppercase font-medium">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-secondary to-transparent"></div>
  </div>
</section>
