---
// Luxury Hero Section
---

<section class="relative min-h-screen flex items-center overflow-hidden gradient-mesh">
  <!-- Animated background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Floating geometric shapes -->
    <div class="absolute top-1/4 left-10 w-64 h-64 border border-gold/10 rotate-45 animate-float"
         style="animation-delay: 0s;"></div>
    <div class="absolute bottom-1/4 right-20 w-48 h-48 border border-gold/10 rotate-12 animate-float"
         style="animation-delay: 2s;"></div>
    <div class="absolute top-1/2 left-1/3 w-32 h-32 border border-gold/5 -rotate-12 animate-float"
         style="animation-delay: 4s;"></div>

    <!-- Grid pattern -->
    <div class="absolute inset-0 pattern-grid opacity-30"></div>

    <!-- Gradient orbs -->
    <div class="absolute top-20 right-1/4 w-[500px] h-[500px] bg-gold/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-1/4 w-[400px] h-[400px] bg-gold/3 rounded-full blur-3xl"></div>
  </div>

  <!-- Main content -->
  <div class="relative container-luxury py-32 lg:py-40">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left content -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-4 mb-8 opacity-0 animate-fade-in-up" style="animation-delay: 0.2s;">
          <div class="gold-line"></div>
          <span class="text-eyebrow">Premier Construction in the UK</span>
        </div>

        <!-- Main headline -->
        <h1 class="heading-xl text-cream mb-6">
          <span class="block opacity-0 animate-fade-in-up" style="animation-delay: 0.3s;">
            Building
          </span>
          <span class="block opacity-0 animate-fade-in-up" style="animation-delay: 0.4s;">
            <em class="text-gradient font-normal">Excellence</em>
          </span>
          <span class="block opacity-0 animate-fade-in-up" style="animation-delay: 0.5s;">
            Since 2004
          </span>
        </h1>

        <!-- Slogan -->
        <p class="font-display text-xl lg:text-2xl text-gold italic mb-8 opacity-0 animate-fade-in-up"
           style="animation-delay: 0.6s;">
          "Building with precision, Delivering with pride"
        </p>

        <!-- Description -->
        <p class="text-large max-w-xl mx-auto lg:mx-0 mb-10 opacity-0 animate-fade-in-up"
           style="animation-delay: 0.7s;">
          From landmark commercial developments to bespoke residential projects,
          we deliver exceptional craftsmanship across the United Kingdom.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start opacity-0 animate-fade-in-up"
             style="animation-delay: 0.8s;">
          <a href="#contact" class="btn-primary">
            <span>Start Your Project</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/projects" class="btn-secondary">
            <span>View Portfolio</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-8 mt-12 opacity-0 animate-fade-in-up"
             style="animation-delay: 0.9s;">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 border border-gold/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-xs text-silver uppercase tracking-wider">Fully</span>
              <span class="text-cream text-sm">Insured</span>
            </div>
          </div>

          <div class="w-px h-10 bg-gold/20 hidden sm:block"></div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 border border-gold/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-xs text-silver uppercase tracking-wider">20+ Years</span>
              <span class="text-cream text-sm">Experience</span>
            </div>
          </div>

          <div class="w-px h-10 bg-gold/20 hidden sm:block"></div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 border border-gold/30 flex items-center justify-center">
              <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="text-left">
              <span class="block text-xs text-silver uppercase tracking-wider">UK</span>
              <span class="text-cream text-sm">Nationwide</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right - Stats showcase -->
      <div class="lg:col-span-5 hidden lg:block">
        <div class="relative opacity-0 animate-slide-right" style="animation-delay: 0.5s;">
          <!-- Decorative frame -->
          <div class="absolute -inset-4 border border-gold/20"></div>
          <div class="absolute -inset-8 border border-gold/10"></div>

          <!-- Main card -->
          <div class="relative glass-gold p-8">
            <!-- Stats grid -->
            <div class="grid grid-cols-2 gap-6">
              <div class="text-center p-6 border border-gold/10 hover:border-gold/30 transition-colors duration-500 group">
                <span class="block font-display text-5xl text-gold group-hover:scale-110 transition-transform duration-500">
                  100<span class="text-3xl">+</span>
                </span>
                <span class="block text-xs text-silver uppercase tracking-wider mt-2">Projects</span>
                <span class="text-cream text-sm">Completed</span>
              </div>

              <div class="text-center p-6 border border-gold/10 hover:border-gold/30 transition-colors duration-500 group">
                <span class="block font-display text-5xl text-gold group-hover:scale-110 transition-transform duration-500">
                  20<span class="text-3xl">+</span>
                </span>
                <span class="block text-xs text-silver uppercase tracking-wider mt-2">Years</span>
                <span class="text-cream text-sm">Experience</span>
              </div>

              <div class="text-center p-6 border border-gold/10 hover:border-gold/30 transition-colors duration-500 group">
                <span class="block font-display text-5xl text-gold group-hover:scale-110 transition-transform duration-500">
                  100<span class="text-3xl">%</span>
                </span>
                <span class="block text-xs text-silver uppercase tracking-wider mt-2">Client</span>
                <span class="text-cream text-sm">Satisfaction</span>
              </div>

              <div class="text-center p-6 border border-gold/10 hover:border-gold/30 transition-colors duration-500 group">
                <span class="block font-display text-5xl text-gold group-hover:scale-110 transition-transform duration-500">
                  6
                </span>
                <span class="block text-xs text-silver uppercase tracking-wider mt-2">Core</span>
                <span class="text-cream text-sm">Services</span>
              </div>
            </div>

            <!-- Bottom text -->
            <div class="mt-8 pt-6 border-t border-gold/10 text-center">
              <p class="text-silver text-sm">
                Trusted by homeowners and businesses across the
                <span class="text-gold">United Kingdom</span>
              </p>
            </div>

            <!-- Corner decorations -->
            <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-gold -translate-x-1 -translate-y-1"></div>
            <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-gold translate-x-1 translate-y-1"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 animate-fade-in"
       style="animation-delay: 1.2s;">
    <span class="text-xs tracking-[0.2em] text-silver uppercase">Scroll</span>
    <div class="w-px h-12 bg-gradient-to-b from-gold to-transparent"></div>
  </div>
</section>
