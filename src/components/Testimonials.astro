---
// PLACEHOLDER: Replace with actual testimonials
const testimonials = [
  {
    quote: "Ayla Construction transformed our outdated office into a modern, inspiring workspace. The attention to detail was outstanding, and they completed the project on time and within budget.",
    author: "James Mitchell",
    role: "Operations Director",
    company: "Tech Solutions Ltd",
    project: "Office Refurbishment",
    rating: 5,
  },
  {
    quote: "From planning to completion, the team was professional and communicative. Our loft conversion has added real value to our home, and we couldn't be happier with the quality of work.",
    author: "Sarah Thompson",
    role: "Homeowner",
    company: "Richmond, London",
    project: "Loft Conversion",
    rating: 5,
  },
  {
    quote: "We've worked with Ayla Construction on multiple retail fit-outs across London. Their reliability and craftsmanship make them our go-to contractor for all our store developments.",
    author: "Michael Chen",
    role: "Property Manager",
    company: "Retail Group UK",
    project: "Retail Fit-outs",
    rating: 5,
  },
];
---

<section id="testimonials" class="relative py-24 lg:py-32 bg-cream overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>
  <div class="absolute top-1/4 left-0 w-64 h-64 bg-gold/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-1/4 right-0 w-96 h-96 bg-charcoal/5 rounded-full blur-3xl"></div>

  <!-- Large Quote Mark Background -->
  <div class="absolute top-20 left-1/2 -translate-x-1/2 text-gold/5 font-display text-[400px] leading-none pointer-events-none select-none hidden lg:block">"</div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="inline-block text-xs tracking-[0.3em] uppercase text-gold mb-4 animate-fade-in">Testimonials</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-charcoal mb-6" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
        What Our Clients Say
      </h2>
      <div class="w-16 h-px bg-gold mx-auto mb-6" style="animation: fadeInUp 0.8s ease-out 0.2s both;"></div>
      <p class="text-charcoal/60 text-lg leading-relaxed" style="animation: fadeInUp 0.8s ease-out 0.3s both;">
        Don't just take our word for it. Here's what our distinguished clients across the UK
        have to say about working with Ayla Construction.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      {testimonials.map((testimonial, index) => (
        <article
          class="group relative bg-white border border-charcoal/10 p-8 lg:p-10 hover:border-gold/40 hover:shadow-2xl transition-all duration-500"
          style={`animation: fadeInUp 0.6s ease-out ${0.4 + index * 0.15}s both;`}
        >
          <!-- Corner Accents -->
          <div class="absolute top-0 left-0 w-8 h-8 border-t border-l border-gold/30 group-hover:border-gold transition-colors duration-300"></div>
          <div class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-gold/30 group-hover:border-gold transition-colors duration-300"></div>

          <!-- Quote Icon -->
          <div class="mb-8">
            <div class="w-12 h-12 bg-gold/10 flex items-center justify-center group-hover:bg-gold/20 transition-colors duration-300">
              <svg class="w-5 h-5 text-gold" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
            </div>
          </div>

          <!-- Rating Stars -->
          <div class="flex gap-1 mb-6">
            {Array.from({ length: testimonial.rating }).map(() => (
              <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-charcoal/70 leading-relaxed mb-8 text-lg font-light italic">
            "{testimonial.quote}"
          </blockquote>

          <!-- Divider -->
          <div class="w-12 h-px bg-gold/30 mb-6"></div>

          <!-- Author -->
          <footer class="flex items-center gap-4">
            <!-- Avatar Placeholder -->
            <div class="w-14 h-14 bg-charcoal flex items-center justify-center flex-shrink-0 border border-gold/20">
              <span class="text-gold font-display text-lg">
                {testimonial.author.split(' ').map(n => n[0]).join('')}
              </span>
            </div>
            <div>
              <cite class="not-italic font-display text-charcoal text-lg block">
                {testimonial.author}
              </cite>
              <span class="text-sm text-charcoal/60">
                {testimonial.role}
              </span>
              <span class="block text-xs text-gold tracking-wider uppercase mt-1">
                {testimonial.project}
              </span>
            </div>
          </footer>
        </article>
      ))}
    </div>

    <!-- Trust Badges -->
    <div class="mt-20 pt-16 border-t border-charcoal/10" style="animation: fadeInUp 0.8s ease-out 1s both;">
      <div class="flex flex-wrap items-center justify-center gap-10 lg:gap-16">
        <div class="group flex items-center gap-3 text-charcoal/60 hover:text-charcoal transition-colors">
          <div class="w-10 h-10 border border-gold/30 flex items-center justify-center group-hover:bg-gold/5 transition-colors">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <span class="text-sm tracking-wider uppercase">Fully Insured</span>
        </div>

        <div class="group flex items-center gap-3 text-charcoal/60 hover:text-charcoal transition-colors">
          <div class="w-10 h-10 border border-gold/30 flex items-center justify-center group-hover:bg-gold/5 transition-colors">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <span class="text-sm tracking-wider uppercase">Quality Guaranteed</span>
        </div>

        <div class="group flex items-center gap-3 text-charcoal/60 hover:text-charcoal transition-colors">
          <div class="w-10 h-10 border border-gold/30 flex items-center justify-center group-hover:bg-gold/5 transition-colors">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <span class="text-sm tracking-wider uppercase">5-Star Rated</span>
        </div>

        <div class="group flex items-center gap-3 text-charcoal/60 hover:text-charcoal transition-colors">
          <div class="w-10 h-10 border border-gold/30 flex items-center justify-center group-hover:bg-gold/5 transition-colors">
            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-sm tracking-wider uppercase">100% Satisfaction</span>
        </div>
      </div>
    </div>
  </div>
</section>
