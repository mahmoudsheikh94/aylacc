---
const faqs = [
  {
    question: "What areas do you cover in the UK?",
    answer: "We primarily serve London and the South East of England, including Surrey, Kent, Essex, and Hertfordshire. For larger commercial projects, we can operate throughout the United Kingdom. Contact us to discuss your specific location."
  },
  {
    question: "How do I get a quote for my construction project?",
    answer: "Getting a quote is simple. Fill out our contact form or call us directly. We'll arrange a site visit to understand your requirements, then provide a detailed, no-obligation quote within 5 working days. Our quotes are comprehensive with no hidden costs."
  },
  {
    question: "Are you fully insured?",
    answer: "Yes, Ayla Construction LTD carries comprehensive public liability insurance, employer's liability insurance, and professional indemnity insurance. We're happy to provide certificates of insurance upon request for your peace of mind."
  },
  {
    question: "How long does a typical construction project take?",
    answer: "Project timelines vary depending on scope and complexity. A loft conversion typically takes 8-12 weeks, while a full refurbishment might take 4-6 months. During our initial consultation, we'll provide a realistic timeline specific to your project."
  },
  {
    question: "Do you handle planning permissions and building regulations?",
    answer: "Yes, we offer a full service including planning applications and building regulations submissions. Our team has extensive experience navigating UK planning requirements and will guide you through the entire process from start to finish."
  },
];

// FAQ Schema for SEO
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section id="faq" class="relative py-24 lg:py-32 bg-gray-50 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-[0.03]">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, #1e3a8a 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-blue-900/20 to-transparent"></div>
  <div class="absolute top-1/3 right-0 w-72 h-72 bg-blue-900/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-1/3 left-0 w-64 h-64 bg-blue-800/3 rounded-full blur-3xl"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 lg:mb-20">
      <span class="inline-block text-xs tracking-[0.3em] uppercase text-blue-900 mb-4 animate-fade-in">Questions</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-gray-900 mb-6" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
        Frequently Asked Questions
      </h2>
      <div class="w-16 h-px bg-blue-900 mx-auto mb-6" style="animation: fadeInUp 0.8s ease-out 0.2s both;"></div>
      <p class="text-gray-600 text-lg leading-relaxed" style="animation: fadeInUp 0.8s ease-out 0.3s both;">
        Got questions? We've got answers. Here are some common queries about
        our construction services in the UK.
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details
          class="card-professional group bg-white border border-gray-200 hover:border-blue-900/30 transition-all duration-300"
          style={`animation: fadeInUp 0.6s ease-out ${0.4 + index * 0.1}s both;`}
        >
          <summary class="flex items-center justify-between gap-6 p-6 lg:p-8 cursor-pointer list-none select-none">
            <div class="flex items-center gap-5">
              <span class="text-blue-900/40 font-display text-lg">0{index + 1}</span>
              <h3 class="font-display text-lg text-gray-900 group-hover:text-blue-900 transition-colors duration-300">
                {faq.question}
              </h3>
            </div>
            <span class="flex-shrink-0 w-10 h-10 border border-blue-900/30 flex items-center justify-center text-blue-900 transition-all duration-300 group-open:bg-blue-900 group-open:text-white group-hover:border-blue-900">
              <svg class="w-4 h-4 transition-transform duration-300 group-open:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </span>
          </summary>
          <div class="px-6 lg:px-8 pb-6 lg:pb-8">
            <div class="pl-12 border-l border-blue-900/20">
              <p class="text-gray-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          </div>
        </details>
      ))}
    </div>

    <!-- Additional CTA -->
    <div class="mt-16 text-center" style="animation: fadeInUp 0.8s ease-out 1s both;">
      <p class="text-gray-500 mb-6 text-sm tracking-wide">
        Still have questions? We're here to help.
      </p>
      <a
        href="#contact"
        class="group inline-flex items-center gap-3 text-blue-900 hover:text-blue-800 font-medium tracking-wider transition-colors duration-300"
      >
        <span>Contact us directly</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
