---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/#about', label: 'About Us' },
  { href: '/projects', label: 'Projects' },
  { href: '/#contact', label: 'Contact' },
];

const services = [
  'Commercial Buildings',
  'Residential Buildings',
  'Fit-outs',
  'Refurbishments',
  'Loft Conversions',
  'Extensions',
];
---

<footer class="relative bg-primary text-white overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
  <div class="absolute top-0 left-1/4 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-secondary/20 rounded-full blur-3xl"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 lg:pt-20 pb-12">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 mb-12">
      <!-- Company Info -->
      <div class="lg:col-span-1">
        <!-- Logo -->
        <div class="mb-6">
          <div class="bg-white rounded-lg p-3 inline-block">
            <img src="/ayla-logo-full.jpg" alt="AYLA Construction & Contracting Co. Ltd." class="h-16 w-auto" />
          </div>
        </div>

        <p class="text-secondary font-display font-medium text-lg mb-5 leading-relaxed">
          Building with precision,<br />Delivering with pride
        </p>

        <p class="text-white/70 text-sm leading-relaxed">
          Premium construction services across the United Kingdom since 2004. Transforming visions into architectural reality.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs tracking-[0.2em] uppercase text-accent-light font-semibold mb-6">Navigation</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group flex items-center gap-2 text-white/70 hover:text-white transition-colors duration-300"
              >
                <span class="w-4 h-px bg-white/30 group-hover:bg-accent group-hover:w-6 transition-all duration-300"></span>
                <span class="text-sm">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-xs tracking-[0.2em] uppercase text-accent-light font-semibold mb-6">Our Services</h3>
        <ul class="space-y-3">
          {services.map((service) => (
            <li class="text-white/60 text-sm hover:text-white/90 transition-colors cursor-default">
              {service}
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-xs tracking-[0.2em] uppercase text-accent-light font-semibold mb-6">Contact</h3>
        <address class="not-italic space-y-4">
          <div class="group flex items-start gap-3">
            <div class="w-10 h-10 bg-white/10 border border-white/20 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-white/15 transition-all duration-300">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="text-white/70 text-sm pt-2">
              <a href="tel:02089932414" class="hover:text-white transition-colors block">T: 020 8993 2414</a>
              <a href="tel:07456664875" class="hover:text-white transition-colors block">M: 074 5666 4875</a>
            </div>
          </div>

          <div class="group flex items-start gap-3">
            <div class="w-10 h-10 bg-white/10 border border-white/20 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-white/15 transition-all duration-300">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <a href="mailto:malek@aylacc.com" class="text-white/70 hover:text-white transition-colors text-sm pt-2">
              malek@aylacc.com
            </a>
          </div>

          <div class="group flex items-start gap-3">
            <div class="w-10 h-10 bg-white/10 border border-white/20 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-white/15 transition-all duration-300">
              <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span class="text-white/60 text-sm pt-2">
              181 Noel Road<br />London W3 0JJ
            </span>
          </div>
        </address>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-white/50 text-xs">
          &copy; {currentYear} Ayla Construction LTD. All rights reserved.
        </p>

        <div class="flex items-center gap-6">
          <span class="text-white/40 text-xs">
            Crafting Exceptional Spaces
          </span>
          <div class="w-12 h-px bg-gradient-to-r from-accent to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</footer>
