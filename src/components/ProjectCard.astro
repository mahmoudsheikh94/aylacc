---
interface Props {
  title: string;
  description: string;
  category: string;
  location: string;
  image: string;
  slug: string;
}

const { title, description, category, location, image, slug } = Astro.props;
---

<article class="group relative overflow-hidden bg-black border border-cream/10 hover:border-gold/40 transition-all duration-500">
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden bg-charcoal">
    <img
      src={image}
      alt={`${title} - ${category} project in ${location}`}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      loading="lazy"
      width="800"
      height="600"
    />

    <!-- Category Badge -->
    <div class="absolute top-4 left-4 z-10">
      <span class="inline-block bg-gold text-charcoal text-xs font-medium px-3 py-1.5 tracking-wider uppercase">
        {category}
      </span>
    </div>

    <!-- Overlay on hover -->
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-end justify-center pb-6">
      <span class="text-gold font-medium tracking-wider text-sm flex items-center gap-2 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
        View Project
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </div>

    <!-- Top Border Accent -->
    <div class="absolute top-0 left-0 w-0 h-0.5 bg-gold group-hover:w-full transition-all duration-500"></div>
  </div>

  <!-- Content -->
  <div class="p-6 bg-gradient-to-b from-black to-charcoal/50">
    <!-- Location -->
    <div class="flex items-center gap-2 text-cream/50 text-xs tracking-wider uppercase mb-3">
      <svg class="w-3.5 h-3.5 text-gold/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {location}
    </div>

    <!-- Title -->
    <h3 class="font-display text-xl text-white group-hover:text-gold transition-colors duration-300 line-clamp-2 mb-3">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-cream/50 text-sm leading-relaxed line-clamp-2">
      {description}
    </p>

    <!-- Bottom Accent Line -->
    <div class="mt-5 pt-4 border-t border-cream/10">
      <div class="flex items-center justify-between">
        <span class="text-gold/60 text-xs tracking-wider uppercase">Completed</span>
        <div class="w-8 h-px bg-gold/30 group-hover:w-16 group-hover:bg-gold transition-all duration-500"></div>
      </div>
    </div>
  </div>

  <!-- Full card link -->
  <a href={`/projects/${slug}`} class="absolute inset-0 z-20" aria-label={`View ${title} project details`}>
    <span class="sr-only">View project: {title}</span>
  </a>

  <!-- Corner Accents on Hover -->
  <div class="absolute top-0 left-0 w-0 h-0 border-t border-l border-gold opacity-0 group-hover:opacity-100 group-hover:w-6 group-hover:h-6 transition-all duration-500"></div>
  <div class="absolute bottom-0 right-0 w-0 h-0 border-b border-r border-gold opacity-0 group-hover:opacity-100 group-hover:w-6 group-hover:h-6 transition-all duration-500"></div>
</article>
