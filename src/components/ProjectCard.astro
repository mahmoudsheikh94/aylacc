---
interface Props {
  title: string;
  description: string;
  category: string;
  location: string;
  image: string;
  slug: string;
}

const { title, description, category, location, image, slug } = Astro.props;
---

<article class="group relative overflow-hidden bg-white rounded-lg border border-gray-200 hover:border-blue-900/40 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-2">
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
    <img
      src={image}
      alt={`${title} - ${category} project in ${location}`}
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
      loading="lazy"
      width="800"
      height="600"
    />

    <!-- Category Badge -->
    <div class="absolute top-4 left-4 z-10">
      <span class="inline-block bg-blue-900 text-white text-xs font-medium px-3 py-1.5 rounded tracking-wider uppercase shadow-md">
        {category}
      </span>
    </div>

    <!-- Overlay on hover -->
    <div class="absolute inset-0 bg-gradient-to-t from-blue-900/90 via-blue-900/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-end justify-center pb-8">
      <span class="text-white font-medium tracking-wider text-sm flex items-center gap-2 translate-y-4 group-hover:translate-y-0 transition-transform duration-500 delay-100">
        View Project
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </span>
    </div>

    <!-- Top Border Accent -->
    <div class="absolute top-0 left-0 w-0 h-1 bg-blue-900 group-hover:w-full transition-all duration-500 ease-out"></div>
  </div>

  <!-- Content -->
  <div class="p-6">
    <!-- Location -->
    <div class="flex items-center gap-2 text-gray-500 text-xs tracking-wider uppercase mb-3">
      <svg class="w-3.5 h-3.5 text-blue-900/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      {location}
    </div>

    <!-- Title -->
    <h3 class="font-display text-xl text-gray-900 group-hover:text-blue-900 transition-colors duration-300 line-clamp-2 mb-3">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-gray-600 text-sm leading-relaxed line-clamp-2">
      {description}
    </p>

    <!-- Bottom Accent Line -->
    <div class="mt-5 pt-4 border-t border-gray-100">
      <div class="flex items-center justify-between">
        <span class="text-blue-900/60 text-xs tracking-wider uppercase font-medium">Completed</span>
        <div class="w-8 h-0.5 bg-blue-900/30 group-hover:w-16 group-hover:bg-blue-900 transition-all duration-500 rounded-full"></div>
      </div>
    </div>
  </div>

  <!-- Full card link -->
  <a href={`/projects/${slug}`} class="absolute inset-0 z-20" aria-label={`View ${title} project details`}>
    <span class="sr-only">View project: {title}</span>
  </a>
</article>
