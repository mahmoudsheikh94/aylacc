---
import { services } from '../data/services';

const icons: Record<string, string> = {
  building: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`,
  home: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`,
  layout: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />`,
  refresh: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />`,
  stairs: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21h6v-6h6v-6h6V3" />`,
  expand: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />`,
};
---

<section id="services" class="section-padding relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-charcoal"></div>
  <div class="absolute inset-0 pattern-dots opacity-50"></div>

  <!-- Decorative elements -->
  <div class="absolute top-0 left-1/4 w-px h-32 bg-gradient-to-b from-transparent via-gold/20 to-transparent"></div>
  <div class="absolute bottom-0 right-1/3 w-px h-32 bg-gradient-to-t from-transparent via-gold/20 to-transparent"></div>

  <div class="relative container-luxury">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-4 mb-6">
        <div class="w-12 h-px bg-gradient-to-r from-transparent to-gold"></div>
        <span class="text-eyebrow">What We Offer</span>
        <div class="w-12 h-px bg-gradient-to-l from-transparent to-gold"></div>
      </div>

      <h2 class="heading-lg text-cream mb-6">
        Our <em class="text-gold font-normal">Services</em>
      </h2>

      <p class="text-large">
        Comprehensive construction solutions tailored to your vision.
        From concept to completion, we deliver excellence.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map((service, index) => (
        <article
          class="group card-luxury p-8 lg:p-10"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <!-- Number & Icon row -->
          <div class="flex items-start justify-between mb-8">
            <div class="w-16 h-16 border border-gold/30 flex items-center justify-center
                        group-hover:border-gold group-hover:bg-gold/10 transition-all duration-500">
              <svg
                class="w-8 h-8 text-gold"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                set:html={icons[service.icon]}
              />
            </div>
            <span class="font-display text-5xl text-gold/20 group-hover:text-gold/40 transition-colors duration-500">
              0{index + 1}
            </span>
          </div>

          <!-- Content -->
          <h3 class="heading-sm text-cream mb-4 group-hover:text-gold transition-colors duration-300">
            {service.title}
          </h3>

          <p class="text-silver mb-6 leading-relaxed">
            {service.description}
          </p>

          <!-- Features -->
          <ul class="space-y-3 mb-8">
            {service.features.slice(0, 3).map((feature) => (
              <li class="flex items-center gap-3 text-sm text-cream/70">
                <span class="w-1.5 h-1.5 bg-gold rounded-full flex-shrink-0"></span>
                {feature}
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a
            href="#contact"
            class="inline-flex items-center gap-3 text-gold text-sm tracking-wide uppercase
                   group-hover:gap-4 transition-all duration-300 hover-line"
          >
            <span>Learn More</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-20 text-center">
      <div class="inline-block glass-gold p-8 lg:p-12">
        <p class="text-cream text-lg mb-6 max-w-xl">
          Not sure which service suits your project?
          <span class="text-gold">Let's discuss your vision.</span>
        </p>
        <a href="#contact" class="btn-primary">
          <span>Schedule a Consultation</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
