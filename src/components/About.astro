---
const timeline = [
  {
    year: '1998',
    title: 'Foundation of Expertise',
    description: 'Malek Sheikh El Ard graduates as a Civil Engineer, beginning a career dedicated to construction excellence.',
  },
  {
    year: '2004',
    title: 'Ayla Construction Founded',
    description: 'Ayla Construction established in Jordan, building a reputation for quality and reliability across the Middle East.',
  },
  {
    year: '2021',
    title: 'UK Operations Begin',
    description: 'Ayla Construction LTD launches in the United Kingdom, bringing decades of expertise to British clients.',
  },
];

const values = [
  {
    title: 'Precision',
    description: 'Every measurement matters. We approach each project with meticulous attention to detail.',
    icon: 'target',
  },
  {
    title: 'Honesty',
    description: 'Transparent communication and fair pricing. No hidden costs, no surprises.',
    icon: 'shield',
  },
  {
    title: 'Excellence',
    description: 'We take pride in our craft and stand behind every project we complete.',
    icon: 'star',
  },
];

const valueIcons: Record<string, string> = {
  target: `<circle cx="12" cy="12" r="10" stroke-width="1.5"/><circle cx="12" cy="12" r="6" stroke-width="1.5"/><circle cx="12" cy="12" r="2" stroke-width="1.5"/>`,
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  star: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />`,
};
---

<section id="about" class="relative section-padding bg-white overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>
  <div class="absolute top-20 right-0 w-96 h-96 bg-accent-light/40 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>

  <!-- Geometric Pattern -->
  <div class="absolute top-1/4 left-8 w-24 h-24 border border-accent/20 rounded-lg hidden lg:block"></div>
  <div class="absolute bottom-1/4 right-8 w-32 h-32 border border-primary/10 rounded hidden lg:block"></div>

  <div class="relative container-professional">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-3 mb-5">
        <div class="blue-line"></div>
        <span class="text-eyebrow">Our Story</span>
      </div>
      <h2 class="heading-lg mb-5">
        About Ayla <span class="text-gradient">Construction</span>
      </h2>
      <p class="text-large">
        Built on decades of experience and an unwavering commitment to excellence
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <!-- Founder Story -->
      <div class="relative">
        <!-- Image/Placeholder -->
        <div class="relative mb-10 group">
          <!-- PLACEHOLDER: Replace with actual founder photo -->
          <div class="aspect-[4/5] bg-gradient-to-br from-primary to-primary-dark overflow-hidden rounded-xl">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(140,182,222,0.2),transparent_50%)]"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center p-8">
                <div class="w-32 h-32 bg-white rounded-full mx-auto mb-6 flex items-center justify-center relative shadow-lg">
                  <span class="text-primary text-6xl font-display font-bold">M</span>
                </div>
                <p class="text-white font-display text-xl font-semibold">Malek Sheikh El Ard</p>
                <p class="text-accent-light text-sm tracking-wide uppercase mt-2 font-medium">Founder &amp; CEO</p>
              </div>
            </div>
          </div>

          <!-- Experience Badge -->
          <div class="absolute -bottom-6 -right-6 lg:-right-10 bg-gradient-to-br from-secondary to-primary text-white px-6 py-4 rounded-lg shadow-xl">
            <span class="block text-3xl font-display font-bold">20+</span>
            <span class="text-xs tracking-wide uppercase font-semibold">Years</span>
          </div>
        </div>

        <!-- Content -->
        <div class="mt-12">
          <h3 class="heading-md mb-6">
            A Legacy of Quality Construction
          </h3>
          <div class="space-y-5 text-text-gray leading-relaxed">
            <p>
              Ayla Construction was founded by Malek Sheikh El Ard, a Civil Engineer who graduated
              in 1998 with a vision to deliver construction projects that stand the test of time.
            </p>
            <p>
              After establishing Ayla Construction in Jordan in 2004 and completing numerous successful
              projects across the Middle East, Malek brought his expertise to the United Kingdom in 2021.
            </p>
            <p>
              Today, Ayla Construction LTD serves discerning clients across London and the South East,
              maintaining the same standards of precision, honesty, and pride that have defined
              our work for over two decades.
            </p>
          </div>
        </div>
      </div>

      <!-- Timeline & Values -->
      <div class="space-y-12 lg:space-y-16">
        <!-- Timeline -->
        <div>
          <h3 class="text-eyebrow mb-8">Our Journey</h3>
          <div class="relative">
            <!-- Timeline Line -->
            <div class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-primary via-secondary to-transparent"></div>

            <div class="space-y-8">
              {timeline.map((item, index) => (
                <div class="relative pl-16 group">
                  <!-- Year Circle -->
                  <div class="absolute left-0 top-0 w-12 h-12 bg-white border-2 border-accent rounded-lg flex items-center justify-center group-hover:bg-primary group-hover:border-primary transition-all duration-300">
                    <span class="text-primary group-hover:text-white text-xs font-bold transition-colors duration-300">{item.year}</span>
                  </div>

                  <div class="pt-2">
                    <h4 class="font-display text-lg font-semibold text-primary mb-2">{item.title}</h4>
                    <p class="text-text-gray text-sm leading-relaxed">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Values -->
        <div>
          <h3 class="text-eyebrow mb-8">Our Values</h3>
          <div class="space-y-4">
            {values.map((value, index) => (
              <div
                class="group flex gap-4 p-6 card-professional hover:shadow-lg"
              >
                <div class="w-12 h-12 bg-accent-light border-2 border-accent rounded-lg flex items-center justify-center flex-shrink-0 group-hover:bg-primary group-hover:border-primary transition-all duration-300">
                  <svg
                    class="w-5 h-5 text-primary group-hover:text-white transition-colors duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    set:html={valueIcons[value.icon]}
                  />
                </div>
                <div>
                  <h4 class="font-display text-primary text-lg font-semibold mb-1">{value.title}</h4>
                  <p class="text-text-gray text-sm leading-relaxed">{value.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
