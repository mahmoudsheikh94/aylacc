---
const timeline = [
  {
    year: '1998',
    title: 'Foundation of Expertise',
    description: 'Malek Sheikh El Ard graduates as a Civil Engineer, beginning a career dedicated to construction excellence.',
  },
  {
    year: '2004',
    title: 'Ayla Construction Founded',
    description: 'Ayla Construction established in Jordan, building a reputation for quality and reliability across the Middle East.',
  },
  {
    year: '2021',
    title: 'UK Operations Begin',
    description: 'Ayla Construction LTD launches in the United Kingdom, bringing decades of expertise to British clients.',
  },
];

const values = [
  {
    title: 'Precision',
    description: 'Every measurement matters. We approach each project with meticulous attention to detail.',
    icon: 'target',
  },
  {
    title: 'Honesty',
    description: 'Transparent communication and fair pricing. No hidden costs, no surprises.',
    icon: 'shield',
  },
  {
    title: 'Excellence',
    description: 'We take pride in our craft and stand behind every project we complete.',
    icon: 'star',
  },
];

const valueIcons: Record<string, string> = {
  target: `<circle cx="12" cy="12" r="10" stroke-width="1.5"/><circle cx="12" cy="12" r="6" stroke-width="1.5"/><circle cx="12" cy="12" r="2" stroke-width="1.5"/>`,
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  star: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />`,
};
---

<section id="about" class="relative py-24 lg:py-32 bg-cream overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>
  <div class="absolute top-20 right-0 w-96 h-96 bg-gold/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-0 w-64 h-64 bg-charcoal/5 rounded-full blur-3xl"></div>

  <!-- Geometric Pattern -->
  <div class="absolute top-1/4 left-8 w-24 h-24 border border-gold/10 rotate-45 hidden lg:block"></div>
  <div class="absolute bottom-1/4 right-8 w-32 h-32 border border-charcoal/10 rotate-12 hidden lg:block"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-20">
      <span class="inline-block text-xs tracking-[0.3em] uppercase text-gold mb-4 animate-fade-in">Our Story</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-charcoal mb-6" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
        About Ayla Construction
      </h2>
      <div class="w-16 h-px bg-gold mx-auto mb-6" style="animation: fadeInUp 0.8s ease-out 0.2s both;"></div>
      <p class="text-charcoal/70 text-lg leading-relaxed" style="animation: fadeInUp 0.8s ease-out 0.3s both;">
        Built on decades of experience and an unwavering commitment to excellence
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-start">
      <!-- Founder Story -->
      <div class="relative" style="animation: slideInLeft 1s ease-out 0.4s both;">
        <!-- Image/Placeholder -->
        <div class="relative mb-10 group">
          <!-- PLACEHOLDER: Replace with actual founder photo -->
          <div class="aspect-[4/5] bg-gradient-to-br from-charcoal to-black overflow-hidden">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(201,169,98,0.1),transparent_50%)]"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="text-center p-8">
                <div class="w-32 h-32 border-2 border-gold/40 mx-auto mb-6 flex items-center justify-center relative">
                  <span class="text-gold text-6xl font-display font-bold">M</span>
                  <div class="absolute -top-2 -left-2 w-4 h-4 border-t-2 border-l-2 border-gold"></div>
                  <div class="absolute -top-2 -right-2 w-4 h-4 border-t-2 border-r-2 border-gold"></div>
                  <div class="absolute -bottom-2 -left-2 w-4 h-4 border-b-2 border-l-2 border-gold"></div>
                  <div class="absolute -bottom-2 -right-2 w-4 h-4 border-b-2 border-r-2 border-gold"></div>
                </div>
                <p class="text-gold font-display text-xl tracking-wide">Malek Sheikh El Ard</p>
                <p class="text-cream/60 text-sm tracking-widest uppercase mt-2">Founder &amp; CEO</p>
              </div>
            </div>
          </div>

          <!-- Experience Badge -->
          <div class="absolute -bottom-6 -right-6 lg:-right-10 bg-gold text-charcoal px-6 py-4 shadow-2xl">
            <span class="block text-3xl font-display font-bold">20+</span>
            <span class="text-xs tracking-widest uppercase">Years</span>
          </div>
        </div>

        <!-- Content -->
        <div class="mt-12">
          <h3 class="font-display text-2xl lg:text-3xl text-charcoal mb-6">
            A Legacy of Quality Construction
          </h3>
          <div class="space-y-5 text-charcoal/70 leading-relaxed">
            <p>
              Ayla Construction was founded by Malek Sheikh El Ard, a Civil Engineer who graduated
              in 1998 with a vision to deliver construction projects that stand the test of time.
            </p>
            <p>
              After establishing Ayla Construction in Jordan in 2004 and completing numerous successful
              projects across the Middle East, Malek brought his expertise to the United Kingdom in 2021.
            </p>
            <p>
              Today, Ayla Construction LTD serves discerning clients across London and the South East,
              maintaining the same standards of precision, honesty, and pride that have defined
              our work for over two decades.
            </p>
          </div>
        </div>
      </div>

      <!-- Timeline & Values -->
      <div class="space-y-16">
        <!-- Timeline -->
        <div style="animation: slideInLeft 1s ease-out 0.5s both;">
          <h3 class="text-xs tracking-[0.2em] uppercase text-gold mb-10">Our Journey</h3>
          <div class="relative">
            <!-- Timeline Line -->
            <div class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-gold via-gold/50 to-transparent"></div>

            <div class="space-y-8">
              {timeline.map((item, index) => (
                <div class="relative pl-16 group" style={`animation: fadeInUp 0.6s ease-out ${0.6 + index * 0.15}s both;`}>
                  <!-- Year Circle -->
                  <div class="absolute left-0 top-0 w-12 h-12 bg-charcoal border border-gold/40 flex items-center justify-center group-hover:bg-gold group-hover:border-gold transition-all duration-500">
                    <span class="text-gold group-hover:text-charcoal text-xs font-bold tracking-wider transition-colors duration-500">{item.year}</span>
                  </div>

                  <div class="pt-2">
                    <h4 class="font-display text-lg text-charcoal mb-2">{item.title}</h4>
                    <p class="text-charcoal/60 text-sm leading-relaxed">{item.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Values -->
        <div style="animation: slideInLeft 1s ease-out 0.7s both;">
          <h3 class="text-xs tracking-[0.2em] uppercase text-gold mb-10">Our Values</h3>
          <div class="space-y-5">
            {values.map((value, index) => (
              <div
                class="group flex gap-5 p-5 bg-white border border-charcoal/10 hover:border-gold/40 hover:shadow-lg transition-all duration-500"
                style={`animation: fadeInUp 0.6s ease-out ${0.8 + index * 0.1}s both;`}
              >
                <div class="w-12 h-12 border border-gold/30 flex items-center justify-center flex-shrink-0 group-hover:bg-gold/5 transition-all duration-300">
                  <svg
                    class="w-5 h-5 text-gold"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    set:html={valueIcons[value.icon]}
                  />
                </div>
                <div>
                  <h4 class="font-display text-charcoal text-lg mb-1">{value.title}</h4>
                  <p class="text-charcoal/60 text-sm leading-relaxed">{value.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
