---
import { services } from '../data/services';

const serviceOptions = services.map(s => s.title);
---

<section id="contact" class="relative py-24 lg:py-32 bg-white overflow-hidden">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-blue-900/20 to-transparent"></div>
  <div class="absolute top-20 right-0 w-72 h-72 bg-blue-900/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-0 w-96 h-96 bg-blue-800/3 rounded-full blur-3xl"></div>

  <!-- Geometric Elements -->
  <div class="absolute top-1/4 left-12 w-20 h-20 border border-blue-900/10 rotate-45 hidden lg:block"></div>
  <div class="absolute bottom-1/4 right-12 w-28 h-28 border border-blue-900/10 -rotate-12 hidden lg:block"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <span class="inline-block text-xs tracking-[0.3em] uppercase text-blue-900 mb-4 animate-fade-in">Contact</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl text-gray-900 mb-6" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
        Get In Touch
      </h2>
      <div class="w-16 h-px bg-blue-900 mx-auto mb-6" style="animation: fadeInUp 0.8s ease-out 0.2s both;"></div>
      <p class="text-gray-600 text-lg leading-relaxed" style="animation: fadeInUp 0.8s ease-out 0.3s both;">
        Ready to discuss your construction project? Contact us today for a free,
        no-obligation quote. We typically respond within 24 hours.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-12 lg:gap-16">
      <!-- Contact Form -->
      <div class="lg:col-span-3" style="animation: slideInLeft 1s ease-out 0.4s both;">
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="card-professional bg-gray-50 border border-gray-200 p-8 lg:p-10"
        >
          <!-- Honeypot field for spam protection -->
          <p class="hidden">
            <label>
              Don't fill this out if you're human: <input name="bot-field" />
            </label>
          </p>
          <input type="hidden" name="form-name" value="contact" />

          <div class="grid sm:grid-cols-2 gap-6">
            <!-- Name -->
            <div class="group">
              <label for="name" class="block text-xs tracking-[0.15em] uppercase text-gray-700 mb-3">
                Full Name <span class="text-blue-900">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full px-4 py-4 bg-white border border-gray-300 text-gray-900
                       focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900
                       transition-all duration-300 placeholder:text-gray-400"
                placeholder="John Smith"
              />
            </div>

            <!-- Email -->
            <div class="group">
              <label for="email" class="block text-xs tracking-[0.15em] uppercase text-gray-700 mb-3">
                Email Address <span class="text-blue-900">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full px-4 py-4 bg-white border border-gray-300 text-gray-900
                       focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900
                       transition-all duration-300 placeholder:text-gray-400"
                placeholder="john@example.com"
              />
            </div>

            <!-- Phone -->
            <div class="group">
              <label for="phone" class="block text-xs tracking-[0.15em] uppercase text-gray-700 mb-3">
                Phone Number
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="w-full px-4 py-4 bg-white border border-gray-300 text-gray-900
                       focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900
                       transition-all duration-300 placeholder:text-gray-400"
                placeholder="+44 7XXX XXXXXX"
              />
            </div>

            <!-- Service -->
            <div class="group">
              <label for="service" class="block text-xs tracking-[0.15em] uppercase text-gray-700 mb-3">
                Service Required
              </label>
              <select
                id="service"
                name="service"
                class="w-full px-4 py-4 bg-white border border-gray-300 text-gray-900
                       focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900
                       transition-all duration-300 appearance-none cursor-pointer"
                style="background-image: url(&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='%231e3a8a'%3E%3Cpath stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M19 9l-7 7-7-7'/%3E%3C/svg%3E&quot;); background-position: right 16px center; background-repeat: no-repeat; background-size: 16px;"
              >
                <option value="">Select a service...</option>
                {serviceOptions.map((service) => (
                  <option value={service}>{service}</option>
                ))}
                <option value="Other">Other / Not Sure</option>
              </select>
            </div>

            <!-- Message -->
            <div class="sm:col-span-2 group">
              <label for="message" class="block text-xs tracking-[0.15em] uppercase text-gray-700 mb-3">
                Tell Us About Your Project <span class="text-blue-900">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-4 bg-white border border-gray-300 text-gray-900
                       focus:outline-none focus:border-blue-900 focus:ring-1 focus:ring-blue-900
                       transition-all duration-300 resize-none placeholder:text-gray-400"
                placeholder="Please describe your project, including location, approximate size, and any specific requirements..."
              ></textarea>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="mt-8">
            <button
              type="submit"
              class="btn-primary group relative w-full sm:w-auto bg-blue-900 hover:bg-blue-800 text-white font-medium
                     px-10 py-4 tracking-wider uppercase text-sm transition-all duration-300
                     flex items-center justify-center gap-3 shadow-lg hover:shadow-xl"
            >
              <span>Send Message</span>
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>
          </div>

          <p class="mt-6 text-xs text-gray-500 tracking-wide">
            By submitting this form, you agree to our privacy policy. We'll never share your information with third parties.
          </p>
        </form>
      </div>

      <!-- Contact Information -->
      <div class="lg:col-span-2" style="animation: slideInLeft 1s ease-out 0.5s both;">
        <div class="bg-blue-900 p-8 lg:p-10 text-white h-full relative overflow-hidden">
          <!-- Decorative Element -->
          <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full blur-2xl"></div>

          <!-- Corner Accents -->
          <div class="absolute top-0 left-0 w-12 h-12 border-t border-l border-white/30"></div>
          <div class="absolute bottom-0 right-0 w-12 h-12 border-b border-r border-white/30"></div>

          <div class="relative">
            <h3 class="font-display text-2xl text-white mb-10">Contact Information</h3>

            <div class="space-y-8">
              <!-- Phone -->
              <div class="group flex items-start gap-5">
                <div class="w-12 h-12 border border-white/30 flex items-center justify-center flex-shrink-0 group-hover:bg-white/10 transition-all duration-300">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="pt-2">
                  <p class="text-xs tracking-[0.15em] uppercase text-white/70 mb-2">Phone</p>
                  <a href="tel:02089932414" class="text-white/90 hover:text-white transition-colors block">T: 020 8993 2414</a>
                  <a href="tel:07456664875" class="text-white/90 hover:text-white transition-colors block">M: 074 5666 4875</a>
                </div>
              </div>

              <!-- Email -->
              <div class="group flex items-start gap-5">
                <div class="w-12 h-12 border border-white/30 flex items-center justify-center flex-shrink-0 group-hover:bg-white/10 transition-all duration-300">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="pt-2">
                  <p class="text-xs tracking-[0.15em] uppercase text-white/70 mb-2">Email</p>
                  <a href="mailto:malek@aylacc.com" class="text-white/90 hover:text-white transition-colors">
                    malek@aylacc.com
                  </a>
                </div>
              </div>

              <!-- Address -->
              <div class="group flex items-start gap-5">
                <div class="w-12 h-12 border border-white/30 flex items-center justify-center flex-shrink-0 group-hover:bg-white/10 transition-all duration-300">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="pt-2">
                  <p class="text-xs tracking-[0.15em] uppercase text-white/70 mb-2">Address</p>
                  <p class="text-white/90">
                    181 Noel Road<br />London W3 0JJ
                  </p>
                </div>
              </div>

              <!-- Hours -->
              <div class="group flex items-start gap-5">
                <div class="w-12 h-12 border border-white/30 flex items-center justify-center flex-shrink-0 group-hover:bg-white/10 transition-all duration-300">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div class="pt-2">
                  <p class="text-xs tracking-[0.15em] uppercase text-white/70 mb-2">Business Hours</p>
                  <p class="text-white/90">
                    Monday - Friday: 8am - 6pm<br />
                    <span class="text-white/60">Saturday: 9am - 2pm</span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Divider -->
            <div class="w-full h-px bg-gradient-to-r from-white/30 via-white/10 to-transparent my-10"></div>

            <!-- Quick Response Promise -->
            <div class="text-center">
              <p class="text-white font-display text-lg mb-2">Quick Response Guarantee</p>
              <p class="text-sm text-white/60">
                We aim to respond to all enquiries within 24 hours during business days.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
