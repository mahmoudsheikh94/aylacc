---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');

// Sort by completion date (newest first)
const projects = allProjects.sort((a, b) =>
  b.data.completionDate.localeCompare(a.data.completionDate)
);

const title = 'Our Projects';
const description = 'Explore our portfolio of construction projects across the United Kingdom. Commercial buildings, residential developments, fit-outs, refurbishments, loft conversions, and extensions.';
---

<BaseLayout title={title} description={description}>
  <Header slot="header" currentPath="/projects" />

  <!-- Page Header -->
  <section class="relative py-20 lg:py-28 overflow-hidden" style="background: linear-gradient(135deg, #1F4E79 0%, #2A5F8F 50%, #3F6FA6 100%);">
    <!-- Decorative Elements -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
    <div class="absolute top-20 right-0 w-72 h-72 bg-white/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-0 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block text-xs tracking-[0.3em] uppercase mb-4 animate-fade-in" style="color: #8CB6DE;">Portfolio</span>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white mb-6" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
        Our Projects
      </h1>
      <div class="w-20 h-1 mx-auto mb-6 rounded-full" style="background: linear-gradient(90deg, #8CB6DE, #D6E6F5); animation: fadeInUp 0.8s ease-out 0.2s both;"></div>
      <p class="text-lg max-w-2xl mx-auto leading-relaxed" style="color: rgba(255,255,255,0.8); animation: fadeInUp 0.8s ease-out 0.3s both;">
        A showcase of our construction work across the United Kingdom.
        Each project demonstrates our commitment to quality and exceptional craftsmanship.
      </p>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="relative py-20 lg:py-28 overflow-hidden" style="background: linear-gradient(180deg, #F9FAFB 0%, #FFFFFF 50%, #F9FAFB 100%);">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-30">
      <div class="absolute inset-0" style="background-image: linear-gradient(90deg, #E5E7EB 1px, transparent 1px), linear-gradient(#E5E7EB 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16 lg:mb-20" style="animation: fadeInUp 0.8s ease-out 0.4s both;">
        <div class="bg-white border border-gray-200 rounded-lg p-6 text-center hover:border-[#8CB6DE] hover:shadow-lg transition-all duration-300">
          <span class="block font-display text-4xl" style="color: #1F4E79;">{projects.length}</span>
          <span class="text-xs tracking-wider uppercase mt-2 block" style="color: #6B7280;">Projects</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg p-6 text-center hover:border-[#8CB6DE] hover:shadow-lg transition-all duration-300">
          <span class="block font-display text-4xl" style="color: #1F4E79;">6</span>
          <span class="text-xs tracking-wider uppercase mt-2 block" style="color: #6B7280;">Service Areas</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg p-6 text-center hover:border-[#8CB6DE] hover:shadow-lg transition-all duration-300">
          <span class="block font-display text-4xl" style="color: #1F4E79;">100%</span>
          <span class="text-xs tracking-wider uppercase mt-2 block" style="color: #6B7280;">Satisfaction</span>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg p-6 text-center hover:border-[#8CB6DE] hover:shadow-lg transition-all duration-300">
          <span class="block font-display text-4xl" style="color: #1F4E79;">20+</span>
          <span class="text-xs tracking-wider uppercase mt-2 block" style="color: #6B7280;">Years Experience</span>
        </div>
      </div>

      <!-- Projects -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {projects.map((project, index) => (
          <div style={`animation: fadeInUp 0.6s ease-out ${0.5 + index * 0.1}s both;`}>
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              category={project.data.category}
              location={project.data.location}
              image={project.data.image}
              slug={project.slug}
            />
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-20 bg-white rounded-xl border border-gray-200 p-10 lg:p-14 text-center relative overflow-hidden" style="box-shadow: 0 4px 24px rgba(31, 78, 121, 0.08); animation: fadeInUp 0.8s ease-out 1s both;">
        <!-- Decorative gradient top border -->
        <div class="absolute top-0 left-0 right-0 h-1 rounded-t-xl" style="background: linear-gradient(90deg, #1F4E79, #3F6FA6, #8CB6DE);"></div>

        <!-- Subtle background accent -->
        <div class="absolute top-0 right-0 w-64 h-64 rounded-full opacity-30 blur-3xl" style="background: radial-gradient(circle, #D6E6F5 0%, transparent 70%);"></div>

        <h2 class="font-display text-3xl mb-4 relative" style="color: #1F4E79;">
          Ready to Start Your Project?
        </h2>
        <p class="max-w-xl mx-auto mb-8 leading-relaxed relative" style="color: #6B7280;">
          Whether you're planning a commercial development, home extension, or refurbishment,
          we'd love to discuss how we can bring your vision to life.
        </p>
        <a
          href="/#contact"
          class="group inline-flex items-center justify-center gap-3 text-white font-semibold px-10 py-4 rounded-lg tracking-wide text-sm transition-all duration-300 hover:-translate-y-1"
          style="background: linear-gradient(135deg, #1F4E79 0%, #3F6FA6 100%); box-shadow: 0 4px 12px rgba(31, 78, 121, 0.3);"
        >
          Get a Free Quote
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
