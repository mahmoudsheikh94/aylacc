---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const { title, description, category, location, completionDate, image, client, duration, value } = project.data;

// Get related projects (same category, excluding current)
const allProjects = await getCollection('projects');
const relatedProjects = allProjects
  .filter(p => p.data.category === category && p.slug !== project.slug)
  .slice(0, 3);

// Project structured data
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: `https://aylacc.com${image}`,
  author: {
    '@type': 'Organization',
    name: 'Ayla Construction LTD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Ayla Construction LTD',
    logo: {
      '@type': 'ImageObject',
      url: 'https://aylacc.com/logo.svg',
    },
  },
  datePublished: `${completionDate}-01-01`,
};
---

<BaseLayout
  title={`${title} | Projects`}
  description={description}
  image={image}
  type="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  </Fragment>

  <Header slot="header" currentPath="/projects" />

  <!-- Project Header -->
  <section class="relative py-20 lg:py-28 overflow-hidden" style="background: linear-gradient(135deg, #1F4E79 0%, #2A5F8F 50%, #3F6FA6 100%);">
    <!-- Decorative Elements -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>
    </div>
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
    <div class="absolute top-20 right-0 w-64 h-64 bg-white/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-3 text-sm">
          <li><a href="/" class="text-white/60 hover:text-white transition-colors">Home</a></li>
          <li class="text-white/40">/</li>
          <li><a href="/projects" class="text-white/60 hover:text-white transition-colors">Projects</a></li>
          <li class="text-white/40">/</li>
          <li style="color: #8CB6DE;">{title}</li>
        </ol>
      </nav>

      <div class="max-w-4xl">
        <span class="inline-block text-white text-xs font-semibold px-4 py-2 rounded tracking-wider uppercase mb-6" style="background: linear-gradient(135deg, #3F6FA6 0%, #8CB6DE 100%);">
          {category}
        </span>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl text-white mb-6" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
          {title}
        </h1>
        <p class="text-lg leading-relaxed mb-8" style="color: rgba(255,255,255,0.8); animation: fadeInUp 0.8s ease-out 0.2s both;">
          {description}
        </p>

        <!-- Project Meta -->
        <div class="flex flex-wrap gap-8" style="color: rgba(255,255,255,0.7); animation: fadeInUp 0.8s ease-out 0.3s both;">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 border border-white/30 rounded flex items-center justify-center">
              <svg class="w-4 h-4" style="color: #8CB6DE;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span>{location}</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 border border-white/30 rounded flex items-center justify-center">
              <svg class="w-4 h-4" style="color: #8CB6DE;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <span>Completed {completionDate}</span>
          </div>
          {duration && (
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 border border-white/30 rounded flex items-center justify-center">
                <svg class="w-4 h-4" style="color: #8CB6DE;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <span>{duration}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Project Content -->
  <section class="relative py-20 lg:py-28 overflow-hidden" style="background: linear-gradient(180deg, #F9FAFB 0%, #FFFFFF 100%);">
    <div class="absolute top-0 left-0 w-full h-px" style="background: linear-gradient(90deg, transparent, #8CB6DE, transparent);"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12 lg:gap-16">
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <!-- Project Main Image -->
          <div class="aspect-video mb-12 overflow-hidden rounded-xl bg-gray-100" style="box-shadow: 0 8px 32px rgba(31, 78, 121, 0.12); animation: fadeInUp 0.8s ease-out 0.4s both;">
            <img
              src={image}
              alt={`${title} - ${category} project in ${location}`}
              class="w-full h-full object-cover"
              width="1200"
              height="675"
            />
          </div>

          <!-- Content -->
          <article class="prose prose-lg max-w-none
            prose-headings:font-display prose-headings:font-semibold
            prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:border-l-4 prose-h2:pl-4 prose-h2:rounded
            prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-4
            prose-p:leading-relaxed
            prose-a:no-underline prose-a:font-medium
            prose-strong:font-semibold
            prose-ul:my-6 prose-li:my-2"
            style="--tw-prose-headings: #1F4E79; --tw-prose-body: #4B5563; --tw-prose-links: #3F6FA6; --tw-prose-bold: #1F1F1F; --tw-prose-bullets: #3F6FA6; animation: fadeInUp 0.8s ease-out 0.5s both;">
            <style>
              article.prose h2 { border-color: #3F6FA6; }
            </style>
            <Content />
          </article>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <!-- Project Details Card -->
          <div class="bg-white rounded-xl p-8 sticky top-24 border border-gray-200 relative overflow-hidden" style="box-shadow: 0 4px 24px rgba(31, 78, 121, 0.08); animation: slideInLeft 1s ease-out 0.6s both;">
            <!-- Decorative top gradient -->
            <div class="absolute top-0 left-0 right-0 h-1 rounded-t-xl" style="background: linear-gradient(90deg, #1F4E79, #3F6FA6, #8CB6DE);"></div>

            <h2 class="font-display text-xl mb-8" style="color: #1F4E79;">Project Details</h2>
            <dl class="space-y-6">
              <div>
                <dt class="text-xs tracking-[0.15em] uppercase mb-2" style="color: #3F6FA6;">Category</dt>
                <dd style="color: #1F1F1F;">{category}</dd>
              </div>
              <div>
                <dt class="text-xs tracking-[0.15em] uppercase mb-2" style="color: #3F6FA6;">Location</dt>
                <dd style="color: #1F1F1F;">{location}</dd>
              </div>
              <div>
                <dt class="text-xs tracking-[0.15em] uppercase mb-2" style="color: #3F6FA6;">Completion</dt>
                <dd style="color: #1F1F1F;">{completionDate}</dd>
              </div>
              {duration && (
                <div>
                  <dt class="text-xs tracking-[0.15em] uppercase mb-2" style="color: #3F6FA6;">Duration</dt>
                  <dd style="color: #1F1F1F;">{duration}</dd>
                </div>
              )}
              {client && (
                <div>
                  <dt class="text-xs tracking-[0.15em] uppercase mb-2" style="color: #3F6FA6;">Client</dt>
                  <dd style="color: #1F1F1F;">{client}</dd>
                </div>
              )}
              {value && (
                <div>
                  <dt class="text-xs tracking-[0.15em] uppercase mb-2" style="color: #3F6FA6;">Project Status</dt>
                  <dd style="color: #1F1F1F;">{value}</dd>
                </div>
              )}
            </dl>

            <div class="w-full h-px my-8" style="background: linear-gradient(90deg, transparent, #E5E7EB, transparent);"></div>

            <!-- CTA -->
            <div class="text-center">
              <p class="text-sm mb-6" style="color: #6B7280;">
                Interested in a similar project?
              </p>
              <a
                href="/#contact"
                class="block w-full text-white font-semibold py-4 px-6 rounded-lg tracking-wide text-sm transition-all duration-300 hover:-translate-y-1 text-center"
                style="background: linear-gradient(135deg, #1F4E79 0%, #3F6FA6 100%); box-shadow: 0 4px 12px rgba(31, 78, 121, 0.3);"
              >
                Get a Free Quote
              </a>
            </div>
          </div>
        </aside>
      </div>

      <!-- Related Projects -->
      {relatedProjects.length > 0 && (
        <div class="mt-20 pt-20 border-t border-gray-200">
          <h2 class="font-display text-3xl mb-12" style="color: #1F4E79;">Related Projects</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {relatedProjects.map((related) => (
              <a
                href={`/projects/${related.slug}`}
                class="group block bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-[#8CB6DE] transition-all duration-500 hover:-translate-y-2"
                style="box-shadow: 0 2px 8px rgba(31, 78, 121, 0.06);"
              >
                <div class="aspect-[4/3] overflow-hidden">
                  <img
                    src={related.data.image}
                    alt={related.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                </div>
                <div class="p-6">
                  <span class="text-xs tracking-wider uppercase" style="color: #3F6FA6;">{related.data.category}</span>
                  <h3 class="font-display text-lg mt-2 transition-colors" style="color: #1F4E79;">
                    {related.data.title}
                  </h3>
                  <p class="text-sm mt-2" style="color: #6B7280;">{related.data.location}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Back to Projects -->
      <div class="mt-16 text-center">
        <a
          href="/projects"
          class="group inline-flex items-center gap-3 font-medium tracking-wider transition-colors"
          style="color: #1F4E79;"
        >
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          Back to All Projects
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
